---
import HeroShape from "@/components/shape/HeroShape";
// Live-Studio: zeigt Code, Webseite und App, die gleichzeitig entstehen.
// Wird auf der Startseite direkt unter den Kunden-Logos eingebunden.
---

<section class="relative overflow-hidden">
  <div class="main-container">
    <div class="container">
      <div class="pt-10 pb-24 xl:pb-28 px-2 sm:px-8">
        <div id="hero-studio" class="cp-studio-stage relative z-1" aria-hidden="true">
          <div class="cp-studio-aura"></div>
          <div class="cp-studio-frame">
            <!-- Code Editor -->
            <div class="cp-panel cp-editor">
              <div class="cp-panel-bar">
                <span></span><span></span><span></span>
                <em>auftrag.ts</em>
              </div>
              <div class="cp-code">
                <p style="--d:0"><b>const</b> anfrage = <i>await</i> formular.<u>senden</u>();</p>
                <p style="--d:1"><b>if</b> (anfrage.ok) {"{"}</p>
                <p style="--d:2" class="cp-indent">crm.<u>speichern</u>(anfrage);</p>
                <p style="--d:3" class="cp-indent">kalender.<u>termin</u>(<s>"Erstgespräch"</s>);</p>
                <p style="--d:4" class="cp-indent">bexio.<u>offerte</u>(anfrage.kunde);</p>
                <p style="--d:5">{"}"}</p>
                <p style="--d:6"><span class="cp-comment">// automatisch erledigt ✓</span></p>
              </div>
            </div>

            <!-- Browser mit Webseite, die sich aufbaut -->
            <div class="cp-panel cp-browser">
              <div class="cp-panel-bar">
                <span></span><span></span><span></span>
                <em class="cp-url">ihre-firma.ch</em>
              </div>
              <div class="cp-site">
                <div class="cp-b cp-nav" style="--d:0"><i></i><i></i><i></i><i></i></div>
                <div class="cp-b cp-hero-block" style="--d:1">
                  <span class="cp-line w80"></span>
                  <span class="cp-line w55"></span>
                  <span class="cp-btn"></span>
                </div>
                <div class="cp-cards">
                  <div class="cp-b cp-card" style="--d:2"></div>
                  <div class="cp-b cp-card" style="--d:3"></div>
                  <div class="cp-b cp-card" style="--d:4"></div>
                </div>
                <div class="cp-b cp-footer-block" style="--d:5"></div>
              </div>
            </div>

            <!-- Handy mit App -->
            <div class="cp-phone">
              <div class="cp-phone-notch"></div>
              <div class="cp-app">
                <p class="cp-app-title">Aufträge heute</p>
                <div class="cp-row" style="--d:0"><span class="cp-dot ok"></span><span class="cp-line w70"></span><span class="cp-tag">fertig</span></div>
                <div class="cp-row" style="--d:1"><span class="cp-dot ok"></span><span class="cp-line w55"></span><span class="cp-tag">fertig</span></div>
                <div class="cp-row" style="--d:2"><span class="cp-dot run"></span><span class="cp-line w65"></span><span class="cp-tag run">läuft</span></div>
                <div class="cp-row" style="--d:3"><span class="cp-dot"></span><span class="cp-line w45"></span><span class="cp-tag muted">offen</span></div>
                <div class="cp-progress"><span></span></div>
              </div>
            </div>

            <!-- Schwebende Hinweise -->
            <div class="cp-chip cp-chip-1"><span>✓</span> Neue Anfrage erhalten</div>
            <div class="cp-chip cp-chip-2"><span>⇄</span> Daten synchronisiert</div>
            <div class="cp-chip cp-chip-3"><span>★</span> Prozess optimiert</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Orange Leuchtform hinter dem Studio (wie früher hinter dem Video) -->
  <div
    id="hero-shape"
    class="absolute bottom-0 -z-1 left-1/2 -translate-x-1/2 pointer-events-none h-100 sm:h-150 lg:h-170 xl:h-210"
  >
    <HeroShape />
  </div>
</section>

<style>
  /* ---------- Live Studio ---------- */
  .cp-studio-stage {
    isolation: isolate;
    max-width: 1120px;
    margin-left: auto;
    margin-right: auto;
  }

  .cp-studio-aura {
    position: absolute;
    inset: -8% -2% -12%;
    z-index: -1;
    background:
      radial-gradient(ellipse at 50% 55%, rgba(255, 152, 0, 0.42) 0%, rgba(243, 106, 0, 0.2) 30%, transparent 68%),
      radial-gradient(ellipse at 50% 0%, rgba(255, 208, 0, 0.2), transparent 58%);
    filter: blur(34px);
    opacity: 0.9;
    animation: cpAuraPulse 4.5s ease-in-out infinite;
    pointer-events: none;
  }

  .cp-studio-frame {
    position: relative;
    display: grid;
    grid-template-columns: 0.95fr 1.45fr 0.6fr;
    gap: clamp(0.75rem, 1.6vw, 1.25rem);
    align-items: center;
    padding: clamp(1rem, 2.4vw, 2rem);
    border: 1px solid rgba(255, 176, 0, 0.3);
    border-radius: clamp(1rem, 2vw, 1.8rem);
    background:
      radial-gradient(circle at 1px 1px, rgba(255, 248, 232, 0.06) 1px, transparent 0) 0 0 / 22px 22px,
      rgba(5, 6, 8, 0.82);
    box-shadow:
      0 34px 100px rgba(0, 0, 0, 0.62),
      0 0 48px rgba(255, 138, 0, 0.17),
      inset 0 1px 0 rgba(255, 208, 0, 0.16);
    min-height: 360px;
  }

  .cp-panel {
    border: 1px solid rgba(255, 248, 232, 0.09);
    border-radius: 14px;
    background: #0d0f13;
    overflow: hidden;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.45);
  }

  .cp-panel-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 12px;
    border-bottom: 1px solid rgba(255, 248, 232, 0.07);
    background: rgba(255, 248, 232, 0.025);
  }

  .cp-panel-bar span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255, 248, 232, 0.16);
  }

  .cp-panel-bar span:first-child {
    background: #ff9800;
  }

  .cp-panel-bar em {
    margin-left: 10px;
    font-style: normal;
    font-size: 11px;
    color: rgba(255, 248, 232, 0.45);
  }

  .cp-url {
    flex: 1;
    padding: 3px 10px;
    border-radius: 999px;
    background: rgba(255, 248, 232, 0.05);
  }

  /* Editor */
  .cp-editor {
    transform: rotate(-1.5deg) translateY(10px);
  }

  .cp-code {
    padding: 14px 14px 18px;
    font-family: ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-size: 11.5px;
    line-height: 1.85;
    color: rgba(255, 248, 232, 0.78);
    text-align: left;
  }

  .cp-code p {
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    width: 0;
    animation: cpType 12s steps(30, end) infinite;
    animation-delay: calc(var(--d) * 0.55s);
  }

  .cp-code .cp-indent {
    padding-left: 1.4em;
  }

  .cp-code b {
    color: #ff9800;
    font-weight: 500;
  }

  .cp-code i {
    color: #ffd000;
    font-style: normal;
  }

  .cp-code u {
    color: #ffe9b0;
    text-decoration: none;
  }

  .cp-code s {
    color: #a6e3a1;
    text-decoration: none;
  }

  .cp-comment {
    color: rgba(255, 248, 232, 0.38);
  }

  /* Browser */
  .cp-browser {
    position: relative;
    z-index: 2;
  }

  .cp-site {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px;
    min-height: 270px;
  }

  .cp-b {
    opacity: 0;
    transform: translateY(14px) scale(0.97);
    animation: cpBuild 12s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
    animation-delay: calc(0.6s + var(--d) * 0.45s);
  }

  .cp-nav {
    display: flex;
    gap: 8px;
    justify-content: flex-end;
    padding: 4px 0;
  }

  .cp-nav i {
    width: 30px;
    height: 6px;
    border-radius: 999px;
    background: rgba(255, 248, 232, 0.16);
  }

  .cp-nav i:first-child {
    width: 46px;
    margin-right: auto;
    background: linear-gradient(90deg, #ffd000, #ff9800);
  }

  .cp-hero-block {
    display: flex;
    flex-direction: column;
    gap: 8px;
    align-items: flex-start;
    padding: 18px 16px;
    border-radius: 10px;
    background:
      radial-gradient(circle at 85% 30%, rgba(255, 152, 0, 0.35), transparent 55%),
      linear-gradient(135deg, #171006, #0d0f13);
    border: 1px solid rgba(255, 176, 0, 0.18);
  }

  .cp-line {
    display: block;
    height: 7px;
    border-radius: 999px;
    background: rgba(255, 248, 232, 0.22);
  }

  .cp-hero-block .cp-line.w80 {
    height: 11px;
    background: rgba(255, 248, 232, 0.55);
  }

  .w80 { width: 80%; }
  .w70 { width: 70%; }
  .w65 { width: 65%; }
  .w55 { width: 55%; }
  .w45 { width: 45%; }

  .cp-btn {
    width: 74px;
    height: 18px;
    margin-top: 4px;
    border-radius: 999px;
    background: linear-gradient(90deg, #ffd000, #ff9800);
    box-shadow: 0 0 18px rgba(255, 152, 0, 0.45);
  }

  .cp-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }

  .cp-card {
    height: 64px;
    border-radius: 9px;
    border: 1px solid rgba(255, 248, 232, 0.08);
    background:
      linear-gradient(rgba(255, 152, 0, 0.55), rgba(255, 152, 0, 0.55)) 10px 12px / 18px 18px no-repeat,
      linear-gradient(rgba(255, 248, 232, 0.2), rgba(255, 248, 232, 0.2)) 10px 40px / 60% 6px no-repeat,
      #12141a;
  }

  .cp-footer-block {
    height: 22px;
    border-radius: 7px;
    background: rgba(255, 248, 232, 0.05);
  }

  /* Handy */
  .cp-phone {
    position: relative;
    z-index: 3;
    width: 100%;
    max-width: 170px;
    aspect-ratio: 9 / 18.5;
    justify-self: center;
    padding: 10px;
    border-radius: 26px;
    border: 1px solid rgba(255, 176, 0, 0.35);
    background: #07080b;
    box-shadow:
      0 24px 60px rgba(0, 0, 0, 0.6),
      0 0 30px rgba(255, 138, 0, 0.15);
    transform: rotate(3deg) translateY(-8px);
    animation: cpFloat 6s ease-in-out infinite;
  }

  .cp-phone-notch {
    width: 42%;
    height: 12px;
    margin: 0 auto 10px;
    border-radius: 999px;
    background: #16181e;
  }

  .cp-app {
    display: flex;
    flex-direction: column;
    gap: 9px;
    text-align: left;
  }

  .cp-app-title {
    margin: 0 0 2px;
    font-size: 11px;
    font-weight: 600;
    color: #fff8e8;
  }

  .cp-row {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px;
    border-radius: 9px;
    background: #12141a;
    border: 1px solid rgba(255, 248, 232, 0.06);
    opacity: 0;
    transform: translateX(16px);
    animation: cpSlide 12s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
    animation-delay: calc(2.4s + var(--d) * 0.4s);
  }

  .cp-row .cp-line {
    flex: 1;
    height: 5px;
  }

  .cp-dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 248, 232, 0.2);
  }

  .cp-dot.ok {
    background: #6fd08c;
  }

  .cp-dot.run {
    background: #ff9800;
    animation: cpPing 1.6s ease-out infinite;
  }

  .cp-tag {
    flex: none;
    font-size: 8px;
    padding: 2px 5px;
    border-radius: 999px;
    color: #6fd08c;
    background: rgba(111, 208, 140, 0.12);
  }

  .cp-tag.run {
    color: #ffb340;
    background: rgba(255, 152, 0, 0.14);
  }

  .cp-tag.muted {
    color: rgba(255, 248, 232, 0.45);
    background: rgba(255, 248, 232, 0.06);
  }

  .cp-progress {
    height: 5px;
    margin-top: 6px;
    border-radius: 999px;
    background: rgba(255, 248, 232, 0.08);
    overflow: hidden;
  }

  .cp-progress span {
    display: block;
    height: 100%;
    width: 0;
    border-radius: inherit;
    background: linear-gradient(90deg, #ffd000, #ff9800);
    animation: cpFill 12s ease-in-out infinite;
  }

  /* Hinweis-Chips */
  .cp-chip {
    position: absolute;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 500;
    color: #fff8e8;
    white-space: nowrap;
    background: rgba(13, 15, 19, 0.92);
    border: 1px solid rgba(255, 176, 0, 0.35);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(8px);
    opacity: 0;
    animation: cpChip 12s ease-in-out infinite;
  }

  .cp-chip span {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    font-size: 11px;
    color: #050608;
    background: linear-gradient(135deg, #ffd000, #ff9800);
  }

  .cp-chip-1 {
    top: -16px;
    left: 30%;
    animation-delay: 3.2s;
  }

  .cp-chip-2 {
    bottom: -16px;
    left: 8%;
    animation-delay: 5s;
  }

  .cp-chip-3 {
    bottom: 22%;
    right: -12px;
    animation-delay: 6.8s;
  }

  /* ---------- Keyframes ---------- */
  @keyframes cpType {
    0% { width: 0; }
    12%, 82% { width: 100%; }
    92%, 100% { width: 0; }
  }

  @keyframes cpBuild {
    0% { opacity: 0; transform: translateY(14px) scale(0.97); }
    6%, 84% { opacity: 1; transform: translateY(0) scale(1); }
    94%, 100% { opacity: 0; transform: translateY(-6px) scale(0.99); }
  }

  @keyframes cpSlide {
    0% { opacity: 0; transform: translateX(16px); }
    6%, 82% { opacity: 1; transform: translateX(0); }
    92%, 100% { opacity: 0; transform: translateX(-8px); }
  }

  @keyframes cpFill {
    0%, 20% { width: 0; }
    70%, 86% { width: 82%; }
    96%, 100% { width: 0; }
  }

  @keyframes cpChip {
    0% { opacity: 0; transform: translateY(10px) scale(0.92); }
    5%, 40% { opacity: 1; transform: translateY(0) scale(1); }
    48%, 100% { opacity: 0; transform: translateY(-8px) scale(0.96); }
  }

  @keyframes cpFloat {
    50% { transform: rotate(3deg) translateY(-18px); }
  }

  @keyframes cpPing {
    0% { box-shadow: 0 0 0 0 rgba(255, 176, 0, 0.55); }
    100% { box-shadow: 0 0 0 9px rgba(255, 176, 0, 0); }
  }

  @keyframes cpAuraPulse {
    50% { opacity: 0.66; transform: scale(1.035); }
  }

  /* ---------- Tablet & Handy ---------- */
  @media (max-width: 1023px) {
    .cp-studio-frame {
      grid-template-columns: 1.5fr 0.62fr;
    }
    .cp-editor {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .cp-studio-frame {
      grid-template-columns: 1fr 0.52fr;
      min-height: 0;
      padding: 0.85rem;
      gap: 0.6rem;
    }
    .cp-site {
      min-height: 210px;
      padding: 10px;
      gap: 7px;
    }
    .cp-card {
      height: 46px;
    }
    .cp-chip {
      font-size: 11px;
      padding: 6px 10px;
    }
    .cp-chip-1 {
      left: 6%;
    }
    .cp-chip-3 {
      display: none;
    }
  }

  .cp-studio-stage {
    opacity: 0;
    transform: translateY(40px);
    transition:
      opacity 1.1s ease,
      transform 1.1s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .cp-studio-stage.is-visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  function initHeroStudio() {
    const stage = document.getElementById("hero-studio");
    if (!stage) return;
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            stage.classList.add("is-visible");
            observer.disconnect();
          }
        });
      },
      { threshold: 0.15 },
    );
    observer.observe(stage);
  }

  document.addEventListener("astro:page-load", initHeroStudio);
</script>
