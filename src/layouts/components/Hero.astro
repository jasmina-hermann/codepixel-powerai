---
import AnimatedButton from "@/components/AnimatedButton.astro";
import { markdownify } from "@/lib/utils/textConverter";
import ImageMod from "./ImageMod.astro";
interface Props {
  data: any;
}
const { data } = Astro.props;
const rotatingWords: string[] = data.rotating_words ?? [];
const rotatingPrefix: string = data.rotating_prefix ?? "";
---

<section class="overflow-hidden relative">
  <div class="h-full w-px bg-light/8 absolute top-0 left-1/2 -translate-x-1/2">
  </div>
  <div class="main-container">
    <div class="container px-0">
      <div class="container-padding-y pb-16 px-0">
        <div class="flex justify-center items-center flex-col text-center px-4">
          <!-- BADGE -->
          {
            data.badge?.enable && (
              <div
                id="hero-badge"
                class="bg-gradient-secondary p-px rounded-full mb-2"
              >
                <div class="px-1.5 py-1.75 bg-gradient-black-grid rounded-full flex items-center gap-2.5">
                  {data.badge.images?.length > 0 && (
                    <ul class="flex">
                      {data.badge.images.map((src: string) => (
                        <li class="border border-secondary rounded-full -mr-2 last:mr-0 size-6">
                          <ImageMod
                            src={src}
                            alt=""
                            width={24}
                            height={24}
                            class="rounded-full object-cover size-full"
                          />
                        </li>
                      ))}
                    </ul>
                  )}
                  <span class="cp-live-dot" aria-hidden="true"></span>
                  <p class="codepixel-badge-label">{data.badge.label}</p>
                </div>
              </div>
            )
          }
          <!-- TITLE -->
          <h1 id="hero-title" class="hero-text mb-4">
            <span set:html={markdownify(data.title).__html} />
            {
              rotatingWords.length > 0 && (
                <span class="cp-rotator-line">
                  {rotatingPrefix && <span>{rotatingPrefix} </span>}
                  <span class="cp-rotator" data-rotator>
                    {rotatingWords.map((word, i) => (
                      <span
                        class:list={[
                          "cp-rotator-word heading-script-accent",
                          { "is-active": i === 0 },
                        ]}
                        aria-hidden={i === 0 ? undefined : "true"}
                      >
                        {word}
                      </span>
                    ))}
                  </span>
                </span>
              )
            }
          </h1>
          <!-- CONTENT -->
          <p id="hero-content" class="text-lg sm:w-3/5">
            {data.content}
          </p>
          <!-- BUTTONS -->
          <div
            id="hero-buttons"
            class="mt-10 flex items-center gap-5 flex-wrap justify-center"
          >
            {
              data.button_dark?.enable && (
                <AnimatedButton
                  classNames="btn btn-dark"
                  href={data.button_dark?.link || "/"}
                >
                  {data.button_dark?.label}
                </AnimatedButton>
              )
            }
            {
              data.button_primary?.enable && (
                <AnimatedButton
                  classNames="btn btn-primary"
                  href={data.button_primary?.link || "/"}
                >
                  {data.button_primary?.label}
                </AnimatedButton>
              )
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .codepixel-badge-label {
    padding: 0.05rem 1rem 0.05rem 0;
    color: #ffd000;
    font-weight: 650;
    letter-spacing: 0.02em;
  }

  .cp-live-dot {
    width: 8px;
    height: 8px;
    margin-left: 0.85rem;
    border-radius: 999px;
    background: #ffd000;
    animation: cpHeroPing 2s ease-out infinite;
  }

  /* Farbiger Verlauf für markierte Wörter (z. B. ==Kunden==) */
  #hero-title :global(mark:not(.heading-script-accent)) {
    color: transparent;
    background: linear-gradient(110deg, #ffd000 0%, #ff9800 58%, #f36a00 100%);
    background-clip: text;
    -webkit-background-clip: text;
  }

  /* ---------- Wechselnde Wörter in Schnürlischrift ---------- */
  .cp-rotator-line {
    display: block;
    margin-top: 0.3em;
  }

  .cp-rotator {
    display: inline-grid;
    vertical-align: baseline;
    text-align: left;
  }

  .cp-rotator-word {
    grid-area: 1 / 1;
    opacity: 0;
    transform: rotate(-2deg) translateY(0.45em);
    filter: blur(6px);
    transition:
      opacity 0.55s ease,
      transform 0.55s cubic-bezier(0.2, 0.8, 0.2, 1),
      filter 0.55s ease;
  }

  .cp-rotator-word.is-active {
    opacity: 1;
    transform: rotate(-2deg) translateY(0.04em);
    filter: blur(0);
  }

  .cp-rotator-word.is-leaving {
    opacity: 0;
    transform: rotate(-2deg) translateY(-0.45em);
    filter: blur(6px);
  }

  @keyframes cpHeroPing {
    0% { box-shadow: 0 0 0 0 rgba(255, 208, 0, 0.6); }
    100% { box-shadow: 0 0 0 9px rgba(255, 208, 0, 0); }
  }
</style>

<script>
  import { animateMini as animate } from "motion";

  function initHero() {
    const smooth = { ease: "easeInOut" as const };
    const items: [string, Record<string, string[]>, number, number][] = [
      ["hero-badge", { opacity: ["0", "1"], transform: ["translateY(-20px)", "translateY(0)"] }, 0.5, 0.2],
      ["hero-title", { opacity: ["0", "1"], transform: ["translateY(20px)", "translateY(0)"] }, 0.8, 0.3],
      ["hero-content", { opacity: ["0", "1"], transform: ["translateY(20px)", "translateY(0)"] }, 0.5, 0.5],
      ["hero-buttons", { opacity: ["0", "1"], transform: ["translateY(20px)", "translateY(0)"] }, 0.5, 0.6],
    ];
    items.forEach(([id, keyframes, duration, delay]) => {
      const el = document.getElementById(id);
      if (!el) return;
      el.style.opacity = "0";
      animate(el, keyframes, { ...smooth, duration, delay });
    });
  }

  let rotatorTimer: number | undefined;

  function initRotator() {
    window.clearInterval(rotatorTimer);
    const rotator = document.querySelector<HTMLElement>("[data-rotator]");
    if (!rotator) return;
    const words = Array.from(
      rotator.querySelectorAll<HTMLElement>(".cp-rotator-word"),
    );
    if (words.length < 2) return;
    let index = 0;
    rotatorTimer = window.setInterval(() => {
      const current = words[index];
      index = (index + 1) % words.length;
      const next = words[index];
      current.classList.remove("is-active");
      current.classList.add("is-leaving");
      current.setAttribute("aria-hidden", "true");
      next.classList.remove("is-leaving");
      next.classList.add("is-active");
      next.removeAttribute("aria-hidden");
      window.setTimeout(() => current.classList.remove("is-leaving"), 600);
    }, 2400);
  }

  document.addEventListener("astro:page-load", () => {
    initHero();
    initRotator();
  });
</script>
