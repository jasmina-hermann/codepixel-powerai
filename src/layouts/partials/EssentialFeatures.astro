---
import ImageMod from "@/components/ImageMod.astro";
import SectionHeader from "@/components/SectionHeader.astro";
interface Props {
  data: any;
}
const { data } = Astro.props;
const { badge, title, features } = data.frontmatter;
const containerUid = `ef-container-${Math.random().toString(36).slice(2, 8)}`;
---

<section>
  <div class="main-container">
    <div class="container">
      <div class="container-padding-y container-padding-x">
        <SectionHeader title={title} badge={badge} />
        <div id={containerUid} class="grid md:grid-cols-6 gap-2.5">
          {features.map((feature: any, index: number) => {
            const itemUid = `ef-item-${Math.random().toString(36).slice(2, 8)}`;
            return (
              <div
                id={itemUid}
                style="opacity:0;background:linear-gradient(145deg,rgba(14,14,16,.98),rgba(34,20,5,.96));border-color:rgba(255,157,0,.22);box-shadow:inset 0 1px 0 rgba(255,255,255,.035),0 18px 55px rgba(0,0,0,.22)"
                class={`${index <= 1 ? "md:col-span-3" : "md:col-span-3 lg:col-span-2"} border rounded-3xl p-2.5 relative group overflow-hidden`}
              >
                <div
                  class="absolute inset-x-10 top-16 h-64 blur-3xl opacity-40"
                  style="background:radial-gradient(circle,rgba(255,166,0,.62) 0%,rgba(255,112,0,.2) 45%,transparent 72%)"
                  aria-hidden="true"
                ></div>

                <ImageMod
                  src={feature.image}
                  alt={feature.title}
                  width={570}
                  height={310}
                  class={`w-full h-auto object-cover relative z-1 ${index > 1 ? "feature-image-orange" : ""}`}
                />
                <div class="mt-6 px-6 pb-12 relative z-1">
                  <h3 class="text-h5 font-medium mb-5">{feature.title}</h3>
                  <p class="text-gray">{feature.content}</p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .feature-image-orange {
    filter: hue-rotate(115deg) saturate(1.22) brightness(1.02);
  }
</style>

<script>
  import { animateMini as animate, inView } from "motion";
  function initEssentialFeatures() {
    document.querySelectorAll<HTMLElement>('[id^="ef-item-"]').forEach((el, i) => {
      el.style.opacity = "0";
      inView(el, () => {
        animate(el, { opacity: [0, 1], transform: ["translateY(20px)", "translateY(0)"] }, { duration: 0.5, ease: "easeInOut", delay: i * 0.1 });
      }, { margin: "-100px", amount: 0.1 });
    });
  }
  document.addEventListener("astro:page-load", initEssentialFeatures);
</script>
