---
import config from "@/config/config.json";

// Karte: Für den genauen Standort in Google Maps auf "Teilen" > "Karte einbetten"
// klicken und nur die Adresse aus src="..." hier einsetzen.
const MAP_SRC =
  "https://www.google.com/maps?q=Codepixel%20Thurgau&hl=de&z=10&output=embed";

const regions = [
  {
    name: "Thurgau",
    note: "Unser Heimatkanton",
    places: [
      "Frauenfeld", "Kreuzlingen", "Arbon", "Amriswil", "Weinfelden",
      "Romanshorn", "Müllheim", "Aadorf", "Sirnach", "Münchwilen",
      "Bischofszell", "Steckborn", "Diessenhofen", "Berlingen", "Güttingen",
      "Kemmental", "Märstetten", "Egnach", "Sulgen", "Bürglen",
    ],
  },
  {
    name: "Zürich",
    note: "Stadt und Kanton",
    places: [
      "Zürich", "Winterthur", "Uster", "Dübendorf", "Dietikon", "Wetzikon",
      "Bülach", "Kloten", "Horgen", "Thalwil", "Küsnacht", "Opfikon",
    ],
  },
  {
    name: "St. Gallen",
    note: "Stadt und Kanton",
    places: [
      "St. Gallen", "Gossau", "Rapperswil-Jona", "Wil", "Uzwil", "Flawil",
      "Rorschach", "Altstätten", "Buchs", "Wattwil", "Widnau", "Au",
    ],
  },
];

const allPlaces = regions.flatMap((r) => r.places);

const schema = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Codepixel",
  url: "https://codepixel.ch/",
  email: config.params.mail,
  telephone: "+41799566661",
  description:
    "IT-Firma im Thurgau: Webseiten, Software, Prozessoptimierung und Coaching für KMU.",
  areaServed: [
    { "@type": "AdministrativeArea", name: "Kanton Thurgau" },
    { "@type": "AdministrativeArea", name: "Kanton Zürich" },
    { "@type": "AdministrativeArea", name: "Kanton St. Gallen" },
    ...allPlaces.map((name) => ({ "@type": "City", name })),
  ],
};
---

<section class="area-section">
  <div class="area-wrap">
    <p class="area-badge">Einsatzgebiet</p>
    <h2>
      Wir arbeiten in Ihrer <span class="heading-script-accent">Region</span>
    </h2>
    <p class="area-lead">
      Persönlich vor Ort im Thurgau, in Zürich und in St. Gallen. Für
      Online-Projekte sind wir in der ganzen Schweiz für Sie da.
    </p>

    <div class="area-map">
      <iframe
        title="Codepixel auf Google Maps"
        src={MAP_SRC}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </div>

    <div class="area-grid">
      {
        regions.map((region) => (
          <article class="area-card">
            <h3>{region.name}</h3>
            <p class="area-note">{region.note}</p>
            <ul>
              {region.places.map((place) => (
                <li>{place}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</section>

<style>
  .area-section {
    padding: 4rem 1.25rem 5rem;
    background: #050608;
  }
  .area-wrap {
    max-width: 68rem;
    margin: 0 auto;
    text-align: center;
  }
  .area-badge {
    display: inline-flex;
    margin: 0;
    padding: 0.45rem 1rem;
    border: 1px solid rgba(255, 176, 0, 0.5);
    border-radius: 999px;
    color: #ffb000;
    background: rgba(255, 157, 0, 0.06);
    font-size: 0.88rem;
    font-weight: 650;
  }
  .area-wrap h2 {
    margin: 1rem 0 0;
    font-size: clamp(1.9rem, 4vw, 3rem);
    font-weight: 500;
    color: #fff8e8;
  }
  .area-lead {
    max-width: 40rem;
    margin: 1rem auto 2rem;
    color: #a6a6aa;
    line-height: 1.7;
  }
  .area-map {
    overflow: hidden;
    margin-bottom: 1.4rem;
    border: 1px solid rgba(255, 176, 0, 0.25);
    border-radius: 1.6rem;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35);
  }
  .area-map iframe {
    display: block;
    width: 100%;
    height: 380px;
    border: 0;
  }
  .area-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.1rem;
    text-align: left;
  }
  .area-card {
    padding: 1.6rem;
    border: 1px solid rgba(255, 176, 0, 0.2);
    border-radius: 1.6rem;
    background:
      radial-gradient(circle at 20% 0%, rgba(255, 157, 0, 0.13), transparent 45%),
      linear-gradient(145deg, rgba(17, 17, 19, 0.98), rgba(29, 20, 8, 0.92));
  }
  .area-card h3 {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 650;
    color: #fff;
  }
  .area-note {
    margin: 0.2rem 0 1rem;
    font-size: 0.9rem;
    color: #a6a6aa;
  }
  .area-card ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .area-card li {
    padding: 0.28rem 0.7rem;
    border: 1px solid rgba(255, 176, 0, 0.25);
    border-radius: 999px;
    font-size: 0.85rem;
    color: #fff8e8;
    background: rgba(255, 157, 0, 0.07);
  }
  @media (max-width: 860px) {
    .area-grid {
      grid-template-columns: 1fr;
    }
    .area-map iframe {
      height: 300px;
    }
  }
</style>
