---
import Logo from "@/components/Logo.astro";
import Social from "@/components/Social.astro";
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import social from "@/config/social.json";
import { markdownify } from "@/lib/utils/textConverter";
const pathname = Astro.url.pathname;
const isEnglish = pathname === "/en" || pathname.startsWith("/en/");
const englishPath = pathname === "/" ? "/en" : `/en${pathname}`;
const germanPath = pathname === "/en" ? "/" : pathname.replace(/^\/en/, "") || "/";
const languageHref = isEnglish ? germanPath : englishPath;
const copyright = isEnglish
  ? "© 2026 Codepixel. All rights reserved."
  : config.params.copyright;
const footerCompany = isEnglish ? menu.footer_company_en : menu.footer_company;
const footerLegal = isEnglish ? menu.footer_legal_en : menu.footer_legal;
const footerText = isEnglish
  ? "Individual digital solutions for companies in Switzerland and beyond. Thoughtful, premium and built to create impact."
  : config.params.footer_text;
const footerSocial = isEnglish
  ? social.main.map((item) => ({
      ...item,
      name: item.name === "Telefon" ? "Phone" : item.name === "E-Mail" ? "Email" : item.name,
    }))
  : social.main;
---

<footer class="pt-25">
  <div class="container">
    <div id="footer-main" style="opacity:0" class="grid md:grid-cols-6 gap-y-12 relative z-1">
      <div class="md:col-span-3">
        <Logo />
        <p class="text-gray mb-10 mt-3 md:w-2/5">{footerText}</p>
        <Social source={footerSocial} className="social-icons flex flex-wrap gap-y-4" />
        <a
          class="footer-language-switch"
          href={languageHref}
          aria-label={isEnglish ? "Deutsche Version öffnen" : "Open English version"}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18" />
          </svg>
          <span>{isEnglish ? "Deutsch" : "English"}</span>
        </a>
      </div>

      <div class="md:col-span-3">
        <div class="grid sm:grid-cols-2 gap-y-10 sm:gap-y-6">
          <div>
            <h3 class="text-xl font-medium mb-10">{isEnglish ? "Company" : "Unternehmen"}</h3>
            <ul class="flex flex-col gap-y-3">
              {footerCompany.map((item: any) => (
                <li><a href={item.url} class="text-gray hover:text-primary transition">{item.name}</a></li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="text-xl font-medium mb-10">{isEnglish ? "Legal" : "Rechtlich"}</h3>
            <ul class="flex flex-col gap-y-3">
              {footerLegal.map((item: any) => (
                <li><a href={item.url} class="text-gray hover:text-primary transition">{item.name}</a></li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom footer -->
    <div id="footer-bottom" style="opacity:0" class="lg:sticky bottom-0 z-0 relative">
      <h1 class="footer-title normal-case leading-tight mt-12 lg:mt-20">codepixel.ch</h1>
      <div class="flex justify-start lg:-translate-y-12 items-center flex-col sm:flex-row gap-y-6 py-6">
        <p class="text-text text-sm" set:html={markdownify(copyright).__html} />
      </div>
    </div>
  </div>
</footer>

<style>
  .footer-language-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    min-height: 2.75rem;
    margin-top: 1.25rem;
    padding: 0 1rem;
    border: 1px solid rgba(255, 176, 0, 0.48);
    border-radius: 999px;
    color: #ffb000;
    background: rgba(255, 157, 0, 0.08);
    font-size: 0.9rem;
    font-weight: 700;
    transition: border-color 0.25s ease, background 0.25s ease, transform 0.25s ease;
  }

  .footer-language-switch:hover {
    border-color: rgba(255, 196, 0, 0.88);
    background: rgba(255, 157, 0, 0.15);
    transform: translateY(-1px);
  }

  .footer-language-switch svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
</style>

<script>
  import { animateMini as animate, inView } from "motion";
  function initFooter() {
    const smooth = { duration: 0.5, ease: "easeInOut" as const };
    const footerMain = document.getElementById("footer-main");
    if (footerMain) {
      footerMain.style.opacity = "0";
      inView(footerMain, () => {
        animate(footerMain, { opacity: [0, 1], transform: ["translateY(20px)", "translateY(0)"] }, smooth);
      }, { margin: "0px", amount: 0.05 });
    }
    const footerBottom = document.getElementById("footer-bottom");
    if (footerBottom) {
      footerBottom.style.opacity = "0";
      inView(footerBottom, () => {
        animate(footerBottom, { opacity: [0, 1], transform: ["translateY(20px)", "translateY(0)"] }, smooth);
      }, { margin: "0px", amount: 0.05 });
    }
  }
  document.addEventListener("astro:page-load", initFooter);
</script>
