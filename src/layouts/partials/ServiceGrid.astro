---
const content = {
  badge: "Unser Angebot",
  title: "Was wir für Sie <span class='heading-script-accent'>tun</span>",
  subtitle:
    "Jeder Bereich hat eine eigene Seite mit typischen Schwierigkeiten, dem Lösungsweg, Paketen und Preisen.",
  services: [
    {
      title: "Webseiten",
      content:
        "Individuelle Webseiten mit klarer Nutzerführung, die Vertrauen schaffen und Anfragen bringen.",
      price: "ab CHF 1'000",
      href: "/leistungen/webseiten",
      icon: "website",
    },
    {
      title: "Software und Apps",
      content:
        "Programme und Apps nach Mass, die Arbeitsabläufe vereinfachen und genau zu Ihrem Betrieb passen.",
      price: "Konzept-Workshop ab CHF 690",
      href: "/leistungen/software",
      icon: "software",
    },
    {
      title: "Prozessoptimierung",
      content:
        "Abläufe verbinden, Doppelspurigkeiten abbauen und wiederkehrende Arbeit automatisieren.",
      price: "Prozess-Check CHF 490",
      href: "/leistungen/prozesse",
      icon: "process",
    },
    {
      title: "Coaching",
      content:
        "Ehrliche Beratung und praxisnahe Begleitung für klare Strukturen, Führung und ein starkes Team.",
      price: "Impuls-Sitzung CHF 190",
      href: "/leistungen/coaching",
      icon: "strategy",
    },
  ],
};
const iconPaths: Record<string, string> = {
  website: '<rect x="3" y="4" width="18" height="15" rx="2"/><path d="M3 8h18M8 22h8M12 19v3"/>',
  software: '<path d="m8 9-3 3 3 3M16 9l3 3-3 3M14 5l-4 14"/>',
  process: '<path d="M8 8h8v8H8zM4 12H2m20 0h-2M12 4V2m0 20v-2M5.6 5.6 4.2 4.2m15.6 15.6-1.4-1.4M18.4 5.6l1.4-1.4M4.2 19.8l1.4-1.4"/>',
  strategy: '<path d="M4 19V9m6 10V5m6 14v-7m4 7H2M4 9l6-4 6 7 4-5"/>',
};
---

<section class="service-grid-section">
  <div class="main-container">
    <div class="container">
      <div class="container-padding-y container-padding-x">
        <div class="mx-auto mb-14 max-w-3xl text-center">
          <span class="service-badge">{content.badge}</span>
          <h2 class="mt-4 text-h2 font-medium" set:html={content.title} />
          <p class="mx-auto mt-5 text-lg text-gray">{content.subtitle}</p>
        </div>
        <div class="service-grid">
          {content.services.map((service) => (
            <a href={service.href} class="service-card">
              <div class="service-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={iconPaths[service.icon]} />
              </div>
              <h3>{service.title}</h3>
              <p>{service.content}</p>
              <span class="service-price">{service.price}</span>
              <span class="service-more">Schwierigkeiten, Lösungen und Preise ansehen →</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .service-grid-section { position: relative; }
  .service-badge {
    display: inline-flex;
    border: 1px solid rgba(255, 176, 0, .5);
    border-radius: 999px;
    padding: .45rem 1rem;
    color: #ffb000;
    background: rgba(255, 157, 0, .06);
    font-size: .88rem;
    font-weight: 650;
  }
  .service-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.2rem;
  }
  .service-card {
    display: flex;
    flex-direction: column;
    min-height: 290px;
    padding: 2rem;
    border: 1px solid rgba(255, 176, 0, .2);
    border-radius: 1.6rem;
    background:
      radial-gradient(circle at 20% 0%, rgba(255, 157, 0, .13), transparent 45%),
      linear-gradient(145deg, rgba(17, 17, 19, .98), rgba(29, 20, 8, .92));
    box-shadow: inset 0 1px 0 rgba(255,255,255,.04), 0 24px 60px rgba(0,0,0,.2);
    text-decoration: none;
    transition: transform .3s ease, border-color .3s ease, box-shadow .3s ease;
  }
  .service-card:hover {
    transform: translateY(-6px);
    border-color: rgba(255, 176, 0, .52);
    box-shadow: 0 26px 70px rgba(255, 138, 0, .1);
  }
  .service-icon {
    width: 3.5rem;
    height: 3.5rem;
    display: grid;
    place-items: center;
    margin-bottom: 1.4rem;
    border-radius: 1rem;
    color: #ffb000;
    background: linear-gradient(145deg, rgba(255, 157, 0, .12), rgba(255, 196, 0, .24));
    border: 1px solid rgba(255, 176, 0, .24);
    transition: transform .4s ease;
  }
  .service-card:hover .service-icon { transform: rotate(-6deg) scale(1.08); }
  .service-icon svg { width: 1.65rem; height: 1.65rem; }
  .service-card h3 { margin-bottom: .7rem; font-size: 1.35rem; font-weight: 650; color: #fff; }
  .service-card p { color: #aaa8ad; line-height: 1.7; }
  .service-price {
    margin-top: auto;
    padding-top: 1.1rem;
    font-weight: 600;
    background: linear-gradient(110deg, #ffd000, #ff9800 60%, #f36a00);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .service-more {
    margin-top: .35rem;
    font-size: .9rem;
    color: #fff8e8;
  }
  @media (max-width: 760px) {
    .service-grid { grid-template-columns: 1fr; }
    .service-card { min-height: 0; padding: 1.55rem; }
  }
</style>
