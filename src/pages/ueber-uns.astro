---
import Base from "@/layouts/Base.astro";
import Reveal from "@/components/Reveal.astro";
import SectionHeader from "@/components/SectionHeader.astro";
import CallToAction from "@/partials/CallToAction.astro";
import GoogleReviews from "@/partials/GoogleReviews";
import PageHeader from "@/partials/PageHeader.astro";
import TrustedClients from "@/partials/TrustedClients";
import fs from "node:fs";
import path from "node:path";
import config from "@/config/config.json";
import { getListPage } from "@/lib/contentParser";
import { services } from "@/lib/services";
import "@/styles/cp-pages.css";

const trusted_clients = await getListPage("sections/trusted-clients.md");

const title = "Über uns | Codepixel";
const description =
  "Codepixel ist Ihre IT-Firma im Thurgau. Persönlich, ehrlich und massgeschneidert: Webseiten, Software, Prozessoptimierung und Coaching für KMU.";

const pageHeader = {
  badge: "Über uns",
  title:
    "Persönlich, ehrlich und <span class='heading-script-accent'>digital</span> stark",
  subtitle:
    "Codepixel ist Ihre IT-Firma im Thurgau. Wir entwickeln Webseiten, Software und digitale Abläufe und begleiten Ihr Team, damit alles im Alltag auch wirklich genutzt wird.",
  button_dark: { enable: true, label: "Unsere Leistungen", link: "/leistungen" },
  button_primary: {
    enable: true,
    label: "Kostenloses Erstgespräch",
    link: "/kontakt",
  },
};

const values = [
  {
    icon: "☺",
    title: "Persönlich",
    text: "Sie sprechen direkt mit der Inhaberin. Ohne Callcenter, ohne Ticketsystem und ohne Umwege.",
  },
  {
    icon: "✓",
    title: "Ehrlich",
    text: "Wir sagen offen, was sinnvoll ist und was nicht. Auch wenn das bedeutet, dass etwas weniger nötig ist.",
  },
  {
    icon: "✎",
    title: "Massgeschneidert",
    text: "Keine Vorlage von der Stange. Jede Lösung passt zu Ihrem Unternehmen, Ihrer Zielgruppe und Ihren Abläufen.",
  },
  {
    icon: "☀",
    title: "Verständlich",
    text: "Technik so erklärt, dass Sie Entscheidungen sicher treffen können, ohne Fachchinesisch.",
  },
];

// Team: Bilder einfach in public/images/team/ ablegen (Dateiname siehe "photo").
// Solange kein Bild vorhanden ist, erscheinen die Initialen.
const findPhoto = (base: string) => {
  for (const ext of ["jpg", "jpeg", "png", "webp"]) {
    const file = path.join(process.cwd(), "public", "images", "team", `${base}.${ext}`);
    if (fs.existsSync(file)) return `/images/team/${base}.${ext}`;
  }
  return null;
};

const team = [
  {
    name: "E. Kasalar",
    nickname: "Captain",
    role: "Verkaufsleiter",
    text: "Er hört zu, versteht Ihr Anliegen und bringt Ihr Projekt auf Kurs. Als Verkaufsleiter ist er Ihr erster Ansprechpartner für Angebote und Beratung.",
    initials: "EK",
    photo: findPhoto("captain"),
  },
  {
    name: "J. Hermann",
    nickname: "Organisationstalent",
    role: "Inhaberin",
    text: "Sie plant, strukturiert und setzt um. Als Inhaberin behält sie Webseiten, Software und Abläufe im Blick, damit am Ende alles zusammenpasst.",
    initials: "JH",
    photo: findPhoto("organisationstalent"),
  },
];

const callToAction = {
  frontmatter: {
    enable: true,
    title: "Lernen wir uns <span class='heading-script-accent'>kennen</span>",
    description:
      "Erzählen Sie uns, was Sie beschäftigt. Im kostenlosen Erstgespräch finden wir gemeinsam heraus, wie wir Sie unterstützen können.",
    button: { enable: true, label: "Erstgespräch vereinbaren", link: "/kontakt" },
  },
};
---

<Base title={title} meta_title={title} description={description}>
  <PageHeader page_header={pageHeader} />

  <!-- Wer wir sind -->
  <section class="cpx-section">
    <div class="main-container">
      <div class="container">
        <div class="container-padding-y container-padding-x">
          <SectionHeader
            badge="Wer wir sind"
            title="Ihre IT-Firma im <span class='heading-script-accent'>Thurgau</span>"
          />

          <div class="cpx-about">
            <div class="cpx-about-text" data-reveal>
              <p>
                Codepixel verbindet Technik, Design und unternehmerisches
                Denken. Wir bauen Webseiten, die Anfragen bringen, entwickeln
                Software und Apps, die zu Ihren Abläufen passen, und räumen auf,
                wo Prozesse Zeit kosten.
              </p>
              <p>
                Dazu gehört für uns mehr als Technik. Neue Werkzeuge helfen nur,
                wenn das Team sie versteht und gerne nutzt. Deshalb begleiten wir
                Sie auf Wunsch mit Coaching, bis die neuen Abläufe im Alltag
                angekommen sind.
              </p>
              <p>
                Wir arbeiten für Unternehmen in der Schweiz, in Deutschland und
                in Österreich. Unser Anspruch: ehrliche Beratung, klare
                Kommunikation und Lösungen, die Sie wirklich weiterbringen.
              </p>
            </div>

            <aside class="cpx-card" data-reveal style="--i:1">
              <h3>Codepixel in Kürze</h3>
              <ul class="cpx-facts">
                <li><span>Standort</span>Thurgau, Schweiz</li>
                <li>
                  <span>Schwerpunkte</span>Webseiten, Software, Prozesse, Coaching
                </li>
                <li><span>Ansprechperson</span>Direkt die Inhaberin</li>
                <li>
                  <span>E-Mail</span><a href={`mailto:${config.params.mail}`}>{config.params.mail}</a>
                </li>
                <li>
                  <span>Telefon</span><a href="tel:+41799566661">{config.params.phone}</a>
                </li>
              </ul>
            </aside>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Unser Team -->
  <section class="cpx-section">
    <div class="main-container">
      <div class="container">
        <div class="container-padding-y container-padding-x">
          <SectionHeader
            badge="Unser Team"
            title="Die Menschen hinter <span class='heading-script-accent'>Codepixel</span>"
          />
          <div class="team-grid">
            {
              team.map((member, i) => (
                <article class="team-card" data-reveal style={`--i:${i}`}>
                  <div class="team-photo">
                    {member.photo ? (
                      <img src={member.photo} alt={`${member.name}, ${member.role}`} loading="lazy" />
                    ) : (
                      <span class="team-initials" aria-hidden="true">{member.initials}</span>
                    )}
                  </div>
                  <p class="team-nick">{member.nickname}</p>
                  <h3>{member.name}</h3>
                  <p class="team-role">{member.role}</p>
                  <p class="team-text">{member.text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Wofür wir stehen -->
  <section class="cpx-section">
    <div class="main-container">
      <div class="container">
        <div class="container-padding-y container-padding-x">
          <SectionHeader
            badge="Unsere Haltung"
            title="Wofür wir <span class='heading-script-accent'>stehen</span>"
          />
          <div class="cpx-values">
            {
              values.map((value, i) => (
                <article class="cpx-value" data-reveal style={`--i:${i}`}>
                  <div class="cpx-value-icon" aria-hidden="true">{value.icon}</div>
                  <h3>{value.title}</h3>
                  <p>{value.text}</p>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Was wir tun -->
  <section class="cpx-section">
    <div class="main-container">
      <div class="container">
        <div class="container-padding-y container-padding-x">
          <SectionHeader
            badge="Was wir tun"
            title="Vier Bereiche, ein <span class='heading-script-accent'>Ansprechpartner</span>"
          />
          <div class="cpx-links">
            {
              services.map((service, i) => (
                <a
                  href={`/leistungen/${service.slug}`}
                  class="cpx-link"
                  data-reveal
                  style={`--i:${i}`}
                >
                  <strong>{service.name}</strong>
                  <span>{service.heroSubtitle}</span>
                  <em>Mehr erfahren →</em>
                </a>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Unternehmen, die uns vertrauen -->
  <TrustedClients data={trusted_clients} client:load />

  <!-- Google Bewertungen -->
  <GoogleReviews client:visible />

  <CallToAction data={callToAction} />
  <Reveal />
</Base>

<style>
  .team-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.4rem;
    max-width: 62rem;
    margin: 0 auto;
  }
  .team-card {
    padding: 2rem 1.6rem;
    text-align: center;
    border: 1px solid rgba(255, 176, 0, 0.2);
    border-radius: 1.6rem;
    background:
      radial-gradient(circle at 50% 0%, rgba(255, 157, 0, 0.14), transparent 55%),
      linear-gradient(145deg, rgba(17, 17, 19, 0.98), rgba(29, 20, 8, 0.92));
    transition: transform 0.3s ease, border-color 0.3s ease;
  }
  .team-card:hover {
    transform: translateY(-6px);
    border-color: rgba(255, 176, 0, 0.52);
  }
  .team-photo {
    width: 170px;
    height: 170px;
    margin: 0 auto 1.3rem;
    border-radius: 50%;
    padding: 4px;
    background: linear-gradient(135deg, #ffd000, #ff9800 60%, #f36a00);
    box-shadow: 0 0 40px rgba(255, 152, 0, 0.25);
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .team-photo img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }
  .team-initials {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: #12141a;
    font-size: 3rem;
    font-weight: 600;
    color: #ffb000;
  }
  .team-nick {
    margin: 0 0 0.2rem;
    font-size: 1.9rem;
    line-height: 1.2;
    font-family: var(--font-accent, Allura, cursive);
    color: #ffb000;
  }
  .team-card h3 {
    margin: 0;
    font-size: 1.35rem;
    font-weight: 650;
    color: #fff;
  }
  .team-role {
    margin: 0.2rem 0 0.9rem;
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #a6a6aa;
  }
  .team-text {
    margin: 0;
    line-height: 1.7;
    color: #aaa8ad;
  }
  @media (max-width: 760px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
