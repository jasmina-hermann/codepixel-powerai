---
import Base from "@/layouts/Base.astro";
import CallToAction from "@/partials/CallToAction.astro";
import GoogleReviews from "@/partials/GoogleReviews";
import PageHeader from "@/partials/PageHeader.astro";
import ProcessFlow from "@/partials/ProcessFlow.astro";
import ServiceGrid from "@/partials/ServiceGrid.astro";
import TrustedClients from "@/partials/TrustedClients";
import { getListPage } from "@/lib/contentParser";

const data = await getListPage("features/-index.md");
const { title, description, meta_title, image, page_header } = data.frontmatter;
const trusted_clients = await getListPage("sections/trusted-clients.md");
const callToAction = await getListPage("sections/call-to-action.md");
---

<Base title={title} meta_title={meta_title} description={description} image={image}>
  <PageHeader page_header={page_header} />
  <ServiceGrid />
  <ProcessFlow />
  <TrustedClients data={trusted_clients} client:visible />
  <GoogleReviews client:visible />
  <CallToAction data={callToAction} />
</Base>
