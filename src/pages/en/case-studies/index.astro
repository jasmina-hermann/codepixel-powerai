---
import Base from "@/layouts/Base.astro";
import CaseStudyCard from "@/components/CaseStudyCard.astro";
import FeaturedCaseStudy from "@/components/FeaturedCaseStudy";
import MainContainer from "@/components/MainContainer.astro";
import CallToAction from "@/partials/CallToAction.astro";
import PageHeader from "@/partials/PageHeader.astro";
import { englishCallToAction, englishCaseStudies } from "@/data/english";

const featuredCaseStudy = englishCaseStudies.find((study) => study.frontmatter.featured);
const pageHeader = {
  title: "Selected digital projects",
  badge: "Our Projects",
  subtitle: "Apps, software, websites, strategy and branding developed around real business requirements.",
};
const callToAction = { frontmatter: englishCallToAction, content: "" };
---

<Base
  title="Projects | Codepixel"
  meta_title="Digital projects and solutions | Codepixel"
  description="Selected apps, websites, software projects, business solutions and branding work by Codepixel."
>
  <PageHeader page_header={pageHeader}>
    {featuredCaseStudy && (
      <FeaturedCaseStudy
        data={featuredCaseStudy}
        basePath="/en/case-studies"
        buttonLabel="View project"
        noImageLabel="No image available"
        disableLink={false}
        client:visible
      />
    )}
  </PageHeader>
  <section>
    <MainContainer>
      <div class="container-padding-x container-padding-y">
        <div class="grid gap-2.5 md:grid-cols-2 lg:grid-cols-3">
          {englishCaseStudies.map((study) => (
            <CaseStudyCard
              data={study}
              basePath="/en/case-studies"
              buttonLabel="View project"
              noImageLabel="No image available"
            />
          ))}
        </div>
      </div>
    </MainContainer>
  </section>
  <CallToAction data={callToAction} />
</Base>
