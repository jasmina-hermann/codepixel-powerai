          </span>
          <span>WhatsApp</span>
          <span class="arrow">↗</span>
        </a>

        <a href="tel:+41799566661" class="contact-btn">
          <span class="contact-btn-icon telefon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </span>
          <span>Telefon</span>
          <span class="arrow">↗</span>
        </a>

        <a href="viber://chat?number=%2B41799566661" class="contact-btn" target="_blank" rel="noopener noreferrer">
          <span class="contact-btn-icon viber">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          </span>
          <span>Viber</span>
          <span class="arrow">↗</span>
        </a>

        <a href="https://t.me/jasminablume" class="contact-btn" target="_blank" rel="noopener noreferrer">
          <span class="contact-btn-icon telegram">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 1 0 12 24 12 12 0 0 0 11.944 0zm4.962 7.224c.1-.002.321.023.465.14.12.098.153.23.171.325.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.479.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
          </span>
          <span>Telegram</span>
          <span class="arrow">↗</span>
        </a>

        <a href="mailto:Jasmina@codepixel.ch" class="contact-btn">
          <span class="contact-btn-icon email">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          </span>
          <span>E-Mail</span>
          <span class="arrow">↗</span>
        </a>
      </div>
    </section>
  </main>
</Base>

<style>
  .codepixel-contact {
    min-height: calc(100vh - 90px);
    position: relative;
    overflow: hidden;
    display: grid;
    place-items: center;
    padding: clamp(4rem, 8vw, 8rem) 1.25rem;
    background:
      radial-gradient(circle at 20% 48%, rgba(255, 138, 0, .16), transparent 27rem),
      radial-gradient(circle at 80% 25%, rgba(255, 208, 0, .07), transparent 23rem),
      #050608;
  }
  .contact-orbit {
    position: absolute;
    border: 1px solid rgba(255, 152, 0, .12);
    border-radius: 50%;
    pointer-events: none;
  }
  .contact-orbit-one { width: 58rem; height: 58rem; left: -32rem; top: 4rem; }
  .contact-orbit-two { width: 38rem; height: 38rem; right: -20rem; bottom: -18rem; }
  .contact-shell {
    width: min(1080px, 100%);
    display: grid;
    grid-template-columns: minmax(260px, 340px) minmax(0, 1fr);
    gap: clamp(3rem, 8vw, 7rem);
    align-items: center;
    position: relative;
    z-index: 1;
  }
  .phone-aura {
    position: absolute;
    left: -8rem;
    width: 34rem;
    height: 34rem;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 152, 0, .42), rgba(243, 106, 0, .18) 35%, transparent 70%);
    filter: blur(30px);
    animation: auraPulse 3.8s ease-in-out infinite;
    pointer-events: none;
  }
  .phone-mockup {
    width: min(310px, 82vw);
    aspect-ratio: .5;
    justify-self: center;
    background: linear-gradient(145deg, #454545, #171717 45%, #555);
    border-radius: 48px;
    padding: 10px;
    box-shadow: 0 32px 80px rgba(0,0,0,.65), 0 0 90px rgba(255, 138, 0, .22);
    position: relative;
    animation: phoneFloat 5s ease-in-out infinite;
  }
  .phone-mockup::before {
    content: "";
    position: absolute;
    top: 16px;
    left: 50%;
    translate: -50% 0;
    width: 104px;
    height: 26px;
    background: #000;
    border-radius: 20px;
    z-index: 2;
  }
  .phone-screen {
    width: 100%;
    height: 100%;
    background: linear-gradient(180deg, #090a12, #12131f);
    border-radius: 39px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .phone-header {
    padding: 60px 22px 22px;
    text-align: center;
    border-bottom: 1px solid rgba(255,255,255,.07);
  }
  .phone-header p {
    color: #ffd000;
    font-size: .85rem;
    font-weight: 700;
    margin: 0;
  }
  .phone-header h1 {
    color: #fff;
    font-size: 1.1rem;
    line-height: 1.2;
    margin: .4rem 0 0;
  }
  .phone-body {
    flex: 1;
    padding: 22px;
    display: flex;
    align-items: center;
  }
  .phone-msg {
    max-width: 91%;
    background: linear-gradient(135deg, rgba(255, 152, 0, .18), rgba(243, 106, 0, .10));
    border: 1px solid rgba(255, 176, 0, .28);
    border-radius: 20px 20px 20px 5px;
    padding: 18px;
    color: #f8f6f1;
    font-size: .95rem;
    line-height: 1.65;
    box-shadow: 0 14px 35px rgba(0,0,0,.22);
    animation: messageIn .7s ease-out .35s both;
  }
  .contact-options { display: flex; flex-direction: column; gap: .8rem; }
  .contact-heading { margin-bottom: 1.2rem; }
  .eyebrow {
    color: #ffb000;
    font-size: .78rem;
    letter-spacing: .18em;
    text-transform: uppercase;
    font-weight: 700;
  }
  .contact-heading h2 {
    color: #f8f6f1;
    font-size: clamp(2.4rem, 5vw, 4.6rem);
    letter-spacing: -.055em;
    line-height: .98;
    margin: .65rem 0 1rem;
  }
  .contact-heading mark {
    color: #ffd000;
    background: none;
  }
  .contact-heading p { color: #a6a6aa; margin: 0; font-size: 1.05rem; }
  .contact-btn {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 72px;
    padding: .85rem 1.15rem;
    color: #f8f6f1;
    background: rgba(255,255,255,.035);
    border: 1px solid rgba(255,176,0,.17);
    border-radius: 18px;
    font-size: 1.05rem;
    font-weight: 650;
    transition: transform .25s ease, border-color .25s ease, background .25s ease, box-shadow .25s ease;
  }
  .contact-btn:hover {
    transform: translateX(8px);
    border-color: rgba(255,176,0,.55);
    background: rgba(255,152,0,.09);
    box-shadow: 0 12px 35px rgba(255,138,0,.09);
  }
  .contact-btn-icon {
    width: 44px;
    height: 44px;
    border-radius: 13px;
    display: grid;
    place-items: center;
    color: white;
    flex: 0 0 auto;
  }
  .contact-btn-icon svg { width: 21px; height: 21px; }
  .whatsapp { background: #25d366; }
  .telefon { background: #087cff; }
  .viber { background: #7360f2; }
  .telegram { background: #2aabee; }
  .email { background: linear-gradient(135deg, #ffb000, #f36a00); }
  .arrow { margin-left: auto; color: #ffb000; font-size: 1.25rem; }
  @keyframes auraPulse { 50% { opacity: .65; transform: scale(1.08); } }
  @keyframes phoneFloat { 50% { transform: translateY(-12px); } }
  @keyframes messageIn {
    from { opacity: 0; transform: translateY(14px) scale(.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  @media (max-width: 780px) {
    .codepixel-contact { padding-top: 3rem; }
    .contact-shell { grid-template-columns: 1fr; gap: 3.5rem; }
    .phone-aura { left: 50%; translate: -50% 0; top: 2rem; width: 28rem; height: 28rem; }
    .contact-options { width: min(620px, 100%); margin-inline: auto; }
    .contact-heading { text-align: center; }
    .contact-heading h2 { font-size: clamp(2.3rem, 11vw, 3.7rem); }
  }
</style>
