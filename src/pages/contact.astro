---
import Base from "@/layouts/Base.astro";
---

<Base
  title="Kontakt | Codepixel"
  description="Kontaktieren Sie Codepixel direkt per WhatsApp, Telefon, Viber, Telegram oder E-Mail."
>
  <main class="codepixel-contact">
    <div class="contact-orbit contact-orbit-one"></div>
    <div class="contact-orbit contact-orbit-two"></div>

    <section class="contact-shell">
      <div class="phone-aura" aria-hidden="true"></div>

      <div class="phone-mockup">
        <div class="phone-screen">
          <div class="phone-header">
            <p>codepixel</p>
            <h1>Jetzt Kontakt aufnehmen</h1>
          </div>
          <div class="phone-body">
            <div class="phone-msg">
              Grüezi! Beschreiben Sie uns Ihr Projekt. Sie erhalten eine erste
              Einschätzung unverbindlich. Wir sind gerne für Sie da.
            </div>
          </div>
        </div>
      </div>

      <div class="contact-options">
        <div class="contact-heading">
          <span class="eyebrow">Direkt erreichbar</span>
          <h2>Wählen Sie Ihren <mark>Kanal</mark></h2>
          <p>Ein Klick verbindet Sie direkt mit Codepixel.</p>
        </div>

        <a href="https://wa.me/41799566661" class="contact-btn" target="_blank" rel="noopener noreferrer">
